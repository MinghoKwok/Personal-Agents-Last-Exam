        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation": {
          "const": "counterline.notification.delivery_recorded"
        },
        "payload": {
          "type": "object",
          "properties": {
            "notification_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "status": {
              "enum": [
                "committed",
                "rejected",
                "unknown",
                "halted"
              ]
            },
            "code": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "stop_run": {
              "type": "boolean"
            },
            "router_event_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "notification_id",
            "status",
            "code",
            "stop_run",
            "router_event_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event_id",
        "at",
        "operation",
        "payload"
      ],
      "additionalProperties": false
