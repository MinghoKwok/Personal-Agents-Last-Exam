{
  "schema_version": "pale.app-contribution.v1",
  "contract_revision": "0.4.0",
  "app_id": "counterline",
  "app_categories": [
    "external"
  ],
  "runtime_manifest_ref": "app.json",
  "interfaces": [
    {
      "interface_id": "agent-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "agent"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role agent",
      "operations": [
        {
          "name": "counterline.help.search",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "counterline.help.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "counterline.cases.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "counterline.cases.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "counterline.offers.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "counterline.commitments.list",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "counterline.commitments.get",
          "effect": "read",
          "caller": "agent"
        },
        {
          "name": "counterline.cases.open",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.cases.send_message",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.cases.take_action",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.cases.close",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.cases.reopen",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.identity.provide",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.offers.accept",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.offers.decline",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.commitments.contest",
          "effect": "write",
          "caller": "agent"
        },
        {
          "name": "counterline.preferences.update",
          "effect": "write",
          "caller": "agent"
        }
      ]
    },
    {
      "interface_id": "infra-mcp",
      "transport": "mcp.stdio",
      "audience": [
        "infra"
      ],
      "status": "implemented",
      "entrypoint_ref": "service.cjs --role infra",
      "operations": [
        {
          "name": "env.reset",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.load_seed",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.apply_event",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.snapshot",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.event_status",
          "effect": "admin",
          "caller": "infra"
        },
        {
          "name": "env.validate_bundle",
          "effect": "admin",
          "caller": "infra"
        }
      ]
    }
  ],
  "state": {
    "owner": "app",
    "isolation_keys": [
      "run_id",
      "app_id"
    ],
    "seed_schema_ref": "schemas/seed.schema.json",
    "snapshot_includes_assets": true,
    "reset_scope": "app_instance",
    "version_checks": "implemented",
    "idempotent_writes": "implemented",
    "concurrency_control": "per-App file lock; source outbox is not implemented",
    "commit_confirmation": "committed + epoch/revision; failures preserve business state",
    "outbox_atomic_with_business_state": "unsupported"
  },
  "events": {
    "accepts": [
      {
        "type": "counterline.commitment.performance_reported",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "counterline.case.followup",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "counterline.commitment.condition_missed",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "counterline.commitment.revoked",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "counterline.contest.answered",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "counterline.offer.added",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      },
      {
        "type": "counterline.notification.delivery_recorded",
        "schema_ref": "schemas/events.schema.json",
        "status": "implemented"
      }
    ],
    "emits": [],
    "trigger_owner": "task_and_infra"
  },
  "shared_data": {
    "identity_binding_ref": "fixtures/binding.json",
    "account_model_ref": "schemas/seed.schema.json",
    "cross_app_references": true,
    "asset_catalog_refs": [
      "assets.catalog.json"
    ]
  },
  "gui_ref": "gui.json",
  "notification_channels": [],
  "subscriptions": {
    "business_owner": "source_app",
    "routing_owner": "infra",
    "task_binding_required": true,
    "preferences_seed_ref": null,
    "status": "unsupported"
  },
  "dependencies": {
    "core_api": "1.2.0",
    "required_apps": [],
    "services": []
  },
  "extensions": [],
  "asset_runtime": {
    "implemented_descriptor_versions": [
      "pale.asset-descriptor.v1"
    ],
    "implemented_mime_types": [
      "image/png",
      "image/jpeg",
      "audio/mpeg",
      "audio/wav",
      "video/mp4",
      "application/json"
    ],
    "implemented_storage_adapters": [
      "storage.file",
      "storage.inline"
    ],
    "max_assets": 64,
    "max_bundle_bytes": 1048576
  },
  "messaging": {
    "publishes": [
      {
        "channel": "channel.email",
        "schema_id": "urn:pale:email-message:2",
        "schema_ref": "schemas/mail-router-message.schema.json",
        "status": "implemented",
        "event_type": "org.pale.mail.notification.v1",
        "payload_schema_id": "urn:pale:email-payload:1"
      }
    ],
    "receives": [],
    "envelope": "cloudevents/1.0"
  }
}
