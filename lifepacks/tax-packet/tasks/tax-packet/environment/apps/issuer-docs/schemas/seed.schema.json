{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "institution": {
      "type": "object",
      "properties": {
        "institution_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "institution_id",
        "name",
        "time_zone"
      ],
      "additionalProperties": false
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "last_four": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "closed_on": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "account_ref",
          "label",
          "last_four",
          "status",
          "closed_on"
        ],
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "account_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "kind": {
            "enum": [
              "tax_form",
              "statement",
              "letter"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tax_year": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 2000,
                "maximum": 2100
              },
              {
                "type": "null"
              }
            ]
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "available_from": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+$"
          },
          "mime_type": {
            "enum": [
              "application/pdf",
              "text/plain"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "base64": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "account_ref",
          "kind",
          "title",
          "tax_year",
          "issued_at",
          "available_from",
          "filename",
          "mime_type",
          "size",
          "sha256",
          "base64"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "institution",
    "accounts",
    "documents"
  ],
  "additionalProperties": false
}
