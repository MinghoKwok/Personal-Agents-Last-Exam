{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "firm": {
      "type": "object",
      "properties": {
        "firm_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accepted_types": {
          "type": "array",
          "items": {
            "enum": [
              "application/pdf",
              "text/plain",
              "text/csv",
              "application/json"
            ]
          },
          "minItems": 1
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_case_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      },
      "required": [
        "firm_id",
        "name",
        "time_zone",
        "accepted_types",
        "max_file_bytes",
        "max_case_bytes"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "open",
              "locked",
              "closed"
            ]
          },
          "access": {
            "enum": [
              "upload",
              "view",
              "none"
            ]
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          },
          "cutoff": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "late_submission_policy": {
            "enum": [
              "reject",
              "archive_only",
              "accept_for_review"
            ]
          }
        },
        "required": [
          "case_id",
          "title",
          "status",
          "access",
          "opened_at",
          "cutoff",
          "late_submission_policy"
        ],
        "additionalProperties": false
      }
    },
    "submissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "submission_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "request_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "enum": [
              "client",
              "assistant"
            ]
          },
          "standing": {
            "enum": [
              "on_time",
              "late_for_review",
              "late_archived"
            ]
          },
          "replaces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "withdrawn_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+$"
                },
                "mime_type": {
                  "enum": [
                    "application/pdf",
                    "text/plain",
                    "text/csv",
                    "application/json"
                  ]
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "base64": {
                  "type": "string"
                }
              },
              "required": [
                "file_id",
                "filename",
                "mime_type",
                "size",
                "sha256",
                "base64"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          }
        },
        "required": [
          "submission_id",
          "case_id",
          "request_ids",
          "submitted_at",
          "actor",
          "standing",
          "replaces",
          "superseded_by",
          "withdrawn_at",
          "note",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "submission_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "submitted",
              "withdrawn"
            ]
          },
          "standing": {
            "enum": [
              "on_time",
              "late_for_review",
              "late_archived"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+$"
                },
                "mime_type": {
                  "enum": [
                    "application/pdf",
                    "text/plain",
                    "text/csv",
                    "application/json"
                  ]
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "file_id",
                "filename",
                "mime_type",
                "size",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "receipt_id",
          "submission_id",
          "case_id",
          "at",
          "kind",
          "standing",
          "files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "account_id",
    "owner_person_id",
    "firm",
    "cases",
    "submissions",
    "receipts"
  ],
  "additionalProperties": false
}
